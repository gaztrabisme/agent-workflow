        {
          "id": "demo-heading", "type": "text", "x": 1190, "y": 205, "width": 570, "height": 230,
          "startMs": 0, "durationMs": 8000, "text": "A quick look\ninside the app.",
          "style": { "fontFamily": "Arial", "fontSize": 56, "fontWeight": 700, "color": "#14243A", "lineHeight": 1.12 },
          "alt": "A quick look inside the app"
        },
        {
          "id": "demo-subtitle", "type": "text", "x": 1190, "y": 390, "width": 570, "height": 110,
          "startMs": 0, "durationMs": 8000, "text": "Select a reporting period and compare the trend in one step.",
          "style": { "fontFamily": "Arial", "fontSize": 25, "fontWeight": 400, "color": "#526173", "lineHeight": 1.4 },
