          ],
          "fixtures": [],
          "cursor": [
            { "atMs": 0, "x": 510, "y": 265 },
            { "atMs": 700, "x": 380, "y": 345 },
            { "atMs": 850, "x": 380, "y": 345, "click": true },
            { "atMs": 1350, "x": 740, "y": 410 }
          ],
          "highlights": [
            { "locator": { "testId": "compare" }, "startMs": 650, "durationMs": 1000, "color": "#F97316" }
          ],
