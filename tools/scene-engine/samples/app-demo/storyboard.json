      "after": "dashboard",
      "durationMs": 24000,
      "background": "#14243A",
      "camera": { "x": 0, "y": 0, "zoom": 1, "tracks": [{ "property": "zoom", "keyframes": [{ "atMs": 0, "value": 1 }, { "atMs": 22000, "value": 1.04 }] }] },
