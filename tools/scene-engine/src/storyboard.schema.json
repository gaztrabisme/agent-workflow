    "appDemoLayer": {
      "allOf": [
        {
          "$ref": "#/$defs/layerBase"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "appDemo"
            },
            "url": {
              "type": "string",
              "pattern": "^http://(127\\.0\\.0\\.1|localhost)(:[0-9]+)?/"
            },
            "appBuildId": {
              "type": "string",
