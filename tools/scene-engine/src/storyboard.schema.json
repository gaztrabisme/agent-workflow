{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scene-engine.invalid/schema/storyboard-1.json",
  "title": "scene-engine storyboard v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "title",
    "width",
    "height",
    "fps",
    "scenes"
  ],
  "properties": {
    "format": {
      "const": "scene-engine/storyboard@1"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "width": {
      "const": 1920
    },
    "height": {
      "const": 1080
    },
    "fps": {
      "const": 30
    },
    "durationMs": {
      "type": "integer",
      "minimum": 1,
      "description": "Optional asserted storyboard end; derived from scene ends if omitted."
    },
    "background": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$",
      "default": "#FFFFFF"
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "default": "en"
    },
    "markers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sceneId",
          "atMs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sceneId": {
            "type": "string"
          },
          "atMs": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scene"
      }
    }
  },
  "$defs": {
    "easing": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "linear",
            "ease-in",
            "ease-out",
            "ease-in-out",
            "step-start",
            "step-end"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cubicBezier"
          ],
          "properties": {
            "cubicBezier": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "number"
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "number"
                }
              ],
              "minItems": 4,
              "maxItems": 4
            }
          }
        }
      ]
    },
    "timeRef": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "marker": {
              "type": "string",
              "minLength": 1
            },
            "wordIndex": {
              "type": "integer",
              "minimum": 0
            },
            "offsetMs": {
              "type": "integer",
              "default": 0
            }
          },
          "oneOf": [
            {
              "required": [
                "marker"
              ]
            },
            {
              "required": [
                "wordIndex"
              ]
            }
          ]
        }
      ]
    },
    "propertyKeyframe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atMs",
        "value"
      ],
      "properties": {
        "atMs": {
          "$ref": "#/$defs/timeRef"
        },
        "value": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ]
        },
        "easing": {
          "$ref": "#/$defs/easing",
          "default": "linear"
        }
      }
    },
    "propertyTrack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "property",
        "keyframes"
      ],
      "properties": {
        "property": {
          "type": "string",
          "minLength": 1
        },
        "keyframes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/propertyKeyframe"
          }
        }
      }
    },
    "rangeTrack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "property",
        "keyframes"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "property": {
          "enum": [
            "opacity",
            "color",
            "fontSize",
            "rotation",
            "x",
            "y"
          ]
        },
        "keyframes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/propertyKeyframe"
          }
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number",
          "default": 0
        },
        "y": {
          "type": "number",
          "default": 0
        },
        "zoom": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1
        },
        "rotation": {
          "type": "number",
          "default": 0
        },
        "anchorX": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.5
        },
        "anchorY": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.5
        },
        "tracks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/propertyTrack"
          }
        }
      }
    },
    "mask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceLayerId"
      ],
      "properties": {
        "sourceLayerId": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "alpha",
            "luma"
          ],
          "default": "alpha"
        },
        "inverted": {
          "type": "boolean",
          "default": false
        },
        "featherPx": {
          "type": "number",
          "minimum": 0,
          "default": 0
        }
      }
    },
    "chartStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fontFamily": {
          "type": "string",
          "default": "Arial"
        },
        "fontSize": {
          "type": "number",
          "default": 14
        },
        "seriesColors": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          }
        },
        "axisTitleX": {
          "type": "string",
          "default": ""
        },
        "axisTitleY": {
          "type": "string",
          "default": ""
        },
        "numberFormat": {
          "type": "string",
          "default": "#,##0.##"
        },
        "gridColor": {
          "type": "string",
          "default": "#D9DDE3"
        }
      }
    },
    "chartBuild": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "grow",
            "draw",
            "reveal"
          ]
        },
        "durationMs": {
          "type": "integer",
          "minimum": 1,
          "default": 600
        },
        "staggerMs": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      }
    },
    "chartState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atMs",
        "series"
      ],
      "properties": {
        "atMs": {
          "$ref": "#/$defs/timeRef"
        },
        "series": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "values"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    "layerBase": {
      "type": "object",
      "required": [
        "id",
        "type",
        "x",
        "y",
        "width",
        "height",
        "startMs",
        "durationMs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
        },
        "name": {
          "type": "string",
          "description": "Stable PowerPoint morph name; repeated names start with !!."
        },
        "type": {
          "type": "string"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "startMs": {
          "type": "integer",
          "minimum": 0
        },
        "durationMs": {
          "type": "integer",
          "minimum": 1
        },
        "z": {
          "type": "integer",
          "default": 0
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1
        },
        "rotation": {
          "type": "number",
          "default": 0
        },
        "scaleX": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1
        },
        "scaleY": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1
        },
        "effects": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "blurPx": {
              "type": "number",
              "minimum": 0
            },
            "backdropBlurPx": {
              "type": "number",
              "minimum": 0
            },
            "blendMode": {
              "enum": [
                "multiply",
                "screen",
                "overlay",
                "darken",
                "lighten"
              ]
            },
            "mask": {
              "$ref": "#/$defs/mask"
            },
            "transform3d": {
              "type": "array",
              "minItems": 16,
              "maxItems": 16,
              "items": {
                "type": "number"
              }
            }
          }
        },
        "tracks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/propertyTrack"
          }
        },
        "anchorX": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.5
        },
        "anchorY": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.5
        },
        "alt": {
          "type": "string",
          "default": ""
        },
        "decorative": {
          "type": "boolean",
          "default": false
        },
        "readingOrder": {
          "type": "integer"
        },
        "entrance": {
          "enum": [
            "none",
            "fade",
            "flyInLeft",
            "flyInRight",
            "flyInUp",
            "flyInDown",
            "wipeLeft"
          ],
          "default": "none"
        },
        "entranceDurationMs": {
          "type": "integer",
          "minimum": 1,
          "default": 500
        }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "durationMs",
        "layers"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
        },
        "startMs": {
          "type": "integer",
          "minimum": 0
        },
        "after": {
          "type": "string",
          "minLength": 1
        },
        "gapMs": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "durationMs": {
          "type": "integer",
          "minimum": 1
        },
        "pptxAtMs": {
          "type": "integer",
          "minimum": 0,
          "description": "Scene-local pose time; defaults to durationMs - 1."
        },
        "background": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "camera": {
          "$ref": "#/$defs/camera"
        },
        "notes": {
          "type": "string",
          "description": "PowerPoint speaker notes; defaults to narration.text."
        },
        "layers": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/textLayer"
              },
              {
                "$ref": "#/$defs/imageLayer"
              },
              {
                "$ref": "#/$defs/chartLayer"
              },
              {
                "$ref": "#/$defs/shapeLayer"
              },
              {
                "$ref": "#/$defs/tableLayer"
              },
              {
                "$ref": "#/$defs/appDemoLayer"
              },
              {
                "$ref": "#/$defs/videoLayer"
              },
              {
                "$ref": "#/$defs/adapterLayer"
              },
              {
                "$ref": "#/$defs/groupLayer"
              }
            ]
          }
        },
        "narration": {
          "$ref": "#/$defs/narration"
        },
        "captions": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/caption"
              }
            },
            {
              "const": "fromWordTimings"
            }
          ]
        }
      }
    },
    "textLayer": {
      "allOf": [
        {
          "$ref": "#/$defs/layerBase"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "text"
            },
            "text": {
              "type": "string"
            },
            "style": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "fontFamily": {
                  "type": "string",
                  "default": "Arial"
                },
                "fontSize": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "default": 32
                },
                "fontWeight": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 900,
                  "default": 400
                },
                "italic": {
                  "type": "boolean",
                  "default": false
                },
                "color": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$",
                  "default": "#111111"
                },
                "align": {
                  "enum": [
                    "left",
                    "center",
                    "right"
                  ],
                  "default": "left"
                },
                "lineHeight": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "default": 1.2
                },
                "letterSpacing": {
                  "type": "number",
                  "default": 0
                },
                "background": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                },
                "wrap": {
                  "type": "boolean",
                  "default": true
                },
                "autoFit": {
                  "enum": [
                    "none",
                    "shrinkText"
                  ],
                  "default": "none"
                },
                "insetPx": {
                  "type": "number",
                  "minimum": 0,
                  "default": 0
                }
              }
            },
            "split": {
              "enum": [
                "none",
                "line",
                "word",
                "grapheme"
              ],
              "default": "none"
            },
            "reveal": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "unit",
                "staggerMs"
              ],
              "properties": {
                "unit": {
                  "enum": [
                    "line",
                    "word",
                    "grapheme"
                  ]
                },
                "staggerMs": {
                  "type": "integer",
                  "minimum": 0
                },
                "mode": {
                  "enum": [
                    "reveal",
                    "typewriter"
                  ],
                  "default": "reveal"
                }
              }
            },
            "runs": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "text"
                ],
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "color": {
                    "type": "string",
                    "pattern": "^#[0-9A-Fa-f]{6}$"
                  },
                  "fontWeight": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 900
                  },
                  "italic": {
                    "type": "boolean"
                  }
                }
              }
            },
            "rangeTracks": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/rangeTrack"
              }
            },
            "bullets": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "text"
                ],
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "level": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 8,
                    "default": 0
                  },
                  "kind": {
                    "enum": [
                      "bullet",
                      "number",
                      "none"
                    ],
                    "default": "bullet"
                  }
                }
              }
            },
            "counter": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "from",
                "to"
              ],
              "properties": {
                "from": {
                  "type": "number"
                },
                "to": {
                  "type": "number"
                },
                "decimals": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 6,
                  "default": 0
                },
                "prefix": {
                  "type": "string",
                  "default": ""
                },
                "suffix": {
                  "type": "string",
                  "default": ""
                }
              }
            }
          },
          "required": [
            "type"
          ],
          "anyOf": [
            {
              "required": [
                "text"
              ]
            },
            {
              "required": [
                "bullets"
              ]
            },
            {
              "required": [
                "counter"
              ]
            }
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "imageLayer": {
      "allOf": [
        {
          "$ref": "#/$defs/layerBase"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "image"
            },
            "src": {
              "type": "string",
              "minLength": 1
            },
            "alt": {
              "type": "string"
            },
            "fit": {
              "enum": [
                "contain",
                "cover",
                "fill"
              ],
              "default": "contain"
            }
          },
          "required": [
            "type",
            "src"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "chartLayer": {
      "allOf": [
        {
          "$ref": "#/$defs/layerBase"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "chart"
            },
            "kind": {
              "enum": [
                "column",
                "bar",
                "line",
                "area",
                "pie",
                "doughnut",
                "scatter",
                "columnStacked",
                "columnStacked100",
                "barStacked",
                "barStacked100",
                "areaStacked",
                "combo"
              ]
            },
            "categories": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "series": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "values"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "values": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "number"
                    }
                  },
                  "xValues": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "number"
                    }
                  },
                  "kind": {
                    "enum": [
                      "column",
                      "line",
                      "area"
                    ]
                  },
                  "axis": {
                    "enum": [
                      "primary",
                      "secondary"
                    ],
                    "default": "primary"
                  }
                }
              }
            },
            "showLegend": {
              "type": "boolean",
              "default": true
            },
            "showValues": {
              "type": "boolean",
              "default": false
            },
            "style": {
              "$ref": "#/$defs/chartStyle"
            },
            "build": {
              "$ref": "#/$defs/chartBuild"
            },
            "dataStates": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/chartState"
              }
            }
          },
          "required": [
            "type",
            "kind",
            "categories",
            "series"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "shapeLayer": {
      "allOf": [
        {
          "$ref": "#/$defs/layerBase"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "shape"
            },
            "shape": {
              "enum": [
                "rect",
                "roundRect",
                "ellipse",
                "line",
                "path"
              ]
            },
            "fill": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "angleDeg",
                    "stops"
                  ],
                  "properties": {
                    "angleDeg": {
                      "type": "number"
                    },
                    "stops": {
                      "type": "array",
                      "minItems": 2,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "offset",
                          "color"
                        ],
                        "properties": {
                          "offset": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          },
                          "color": {
                            "type": "string",
                            "pattern": "^#[0-9A-Fa-f]{6}$"
                          },
                          "opacity": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1,
                            "default": 1
                          }
                        }
                      }
                    }
                  }
                }
              ]
            },
            "stroke": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "strokeWidth": {
              "type": "number",
              "minimum": 0
            },
            "strokeDash": {
              "enum": [
                "solid",
                "dash",
                "dot"
              ]
            },
            "strokeDashOffset": {
              "type": "number",
              "default": 0
            },
            "radiusPx": {
              "type": "number",
              "minimum": 0,
              "default": 0
            },
            "trimStart": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0
            },
            "trimEnd": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 1
            },
            "shadow": {
              "type": "object",
              "additionalProperties": false,
