                    "oneOf": [
                      {
                        "required": [
                          "role"
                        ]
                      },
                      {
                        "required": [
                          "testId"
                        ]
                      },
                      {
                        "required": [
                          "css"
                        ]
                      }
                    ]
                  },
                  "value": {
                    "type": "string"
                  },
                  "key": {
                    "type": "string"
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "action": {
                          "const": "goto"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "url"
                      ]
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "action": {
                          "const": "click"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "locator"
                      ]
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "action": {
                          "const": "fill"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "locator",
                        "value"
                      ]
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "action": {
                          "const": "selectOption"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "locator",
                        "value"
                      ]
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "action": {
                          "const": "press"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "locator",
                        "key"
                      ]
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "action": {
                          "const": "waitFor"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "locator"
                      ]
                    }
                  }
                ]
              }
            },
            "fixtures": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "urlPattern",
                  "status",
                  "bodyFile"
                ],
                "properties": {
                  "urlPattern": {
                    "type": "string",
                    "description": "Playwright URL glob pattern; regular expressions are not accepted."
                  },
                  "method": {
                    "type": "string",
                    "default": "GET"
                  },
                  "status": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 599
                  },
                  "bodyFile": {
                    "type": "string"
                  },
                  "contentType": {
                    "type": "string",
                    "default": "application/octet-stream"
                  }
                }
              }
            },
            "cursor": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "atMs",
                  "x",
                  "y"
                ],
                "properties": {
                  "atMs": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "click": {
                    "type": "boolean",
                    "default": false
                  },
                  "easing": {
                    "$ref": "#/$defs/easing",
                    "default": "linear"
                  }
                }
              }
            },
            "highlights": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "locator",
                  "startMs",
                  "durationMs"
                ],
                "properties": {
                  "locator": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "role": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "testId": {
                        "type": "string"
                      },
                      "css": {
                        "type": "string"
                      }
                    },
                    "oneOf": [
                      {
                        "required": [
                          "role"
                        ]
                      },
                      {
                        "required": [
                          "testId"
                        ]
                      },
                      {
                        "required": [
                          "css"
                        ]
                      }
                    ]
                  },
                  "startMs": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "durationMs": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "color": {
                    "type": "string",
                    "pattern": "^#[0-9A-Fa-f]{6}$",
                    "default": "#FF3B30"
                  }
                }
              }
            }
          },
          "required": [
            "type",
            "url",
            "readySelector",
            "steps"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
