                "properties": {
                  "atMs": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "timeoutMs": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 5000
                  },
                  "action": {
                    "enum": [
                      "goto",
                      "click",
                      "fill",
                      "selectOption",
                      "press",
                      "waitFor"
                    ]
                  },
                  "url": {
                    "type": "string"
                  },
                  "locator": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "role": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "testId": {
                        "type": "string"
                      },
                      "css": {
                        "type": "string"
                      }
