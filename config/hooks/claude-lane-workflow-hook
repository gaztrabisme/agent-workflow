#!/usr/bin/env bash
# Turns the phrase "dynamic workflow" into a provider-lane run instead of
# Claude Code's own Workflow/Agent fan-out.
#
# UserPromptSubmit: a prompt containing "dynamic workflow" marks the session
#   and injects the routing instruction. A later prompt that says "ultracode"
#   without "dynamic workflow" clears the mark (Claude's own workflow again).
# PreToolUse (Workflow|Agent): denied while the session is marked, so units
#   go to the subagent MCP providers (codex, deepseek, glm, gemini, bppc, omlx).

INPUT=$(cat)
EVENT=$(jq -r '.hook_event_name // empty' <<<"$INPUT")
SESSION=$(jq -r '.session_id // "nosession"' <<<"$INPUT")
MARK_DIR="${TMPDIR:-/tmp}/claude-lane-workflow"
MARK="$MARK_DIR/$SESSION"

case "$EVENT" in
UserPromptSubmit)
    PROMPT=$(jq -r '.prompt // empty' <<<"$INPUT")
    if grep -qiE 'dynamic[ -]workflow' <<<"$PROMPT"; then
        mkdir -p "$MARK_DIR" && touch "$MARK"
        jq -n --arg ctx "LANE WORKFLOW MODE (owner hook). In this owner's setup, \"dynamic workflow\" does NOT mean Claude Code's Workflow tool or Agent fan-out; both are blocked for this session. It means a conductor-style run on the subagent MCP providers:
1. Invoke the project skill; ENGINE is the provider-lane dynamic workflow (project references/run/workflow-patterns.md, 'Provider-lane dynamic workflow').
2. Run the lane check in project references/run/lane-plan.md (load ~/.config/agent-capabilities/subagent.env, subagent doctor --prompt --json, lane_state.json) and plan only onto open lanes.
3. Declare the Plan Block with the full LANE PLAN up front: every unit gets a provider lane (primary + fallback), a Target/Change/Acceptance brief, an acceptance command, and its stage/wave. Stop for go.
4. After go, you are the pipeline: mcp__subagent__delegate per unit (independent units of a wave in parallel, separate workspaces), mcp__subagent__await right after each (wait_seconds >= 1800), run each acceptance command yourself and read an output sample, then start the next wave. Reroute refusals per the quota fallback; if no lane fits, the unit is blocked and reported, never done by you." \
            '{hookSpecificOutput: {hookEventName: "UserPromptSubmit", additionalContext: $ctx}}'
    elif grep -qi 'ultracode' <<<"$PROMPT"; then
        rm -f "$MARK"
    fi
    ;;
PreToolUse)
    if [[ -f "$MARK" ]]; then
        TOOL=$(jq -r '.tool_name // empty' <<<"$INPUT")
        jq -n --arg why "Lane workflow mode is on for this session (the owner said \"dynamic workflow\"): $TOOL is blocked. Dispatch the unit to a provider lane with mcp__subagent__delegate per the project lane plan. To use Claude's own workflow again, the owner says \"ultracode\"." \
            '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "deny", permissionDecisionReason: $why}}'
    fi
    ;;
esac
exit 0
