{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:organized-mind:archive-locator:1",
  "title": "archive-locator",
  "anyOf": [
    {
      "$ref": "urn:organized-mind:locator:1"
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "asset-bytes"
        },
        "start_offset": {
          "type": "integer",
          "minimum": 0
        },
        "end_offset": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "kind",
        "start_offset",
        "end_offset"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "html-text"
        },
        "start_offset": {
          "type": "integer",
          "minimum": 0
        },
        "end_offset": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "kind",
        "start_offset",
        "end_offset"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "lesson-frame"
        },
        "lesson_id": {
          "type": "string",
          "minLength": 1
        },
        "requested_seconds": {
          "type": "number",
          "minimum": 0
        },
        "actual_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "actual_time_reason": {
          "enum": [
            null,
            "not found"
          ]
        }
      },
      "required": [
        "kind",
        "lesson_id",
        "requested_seconds",
        "actual_seconds",
        "actual_time_reason"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "actual_seconds": {
                "const": null
              }
            }
          },
          "then": {
            "properties": {
              "actual_time_reason": {
                "const": "not found"
              }
            }
          },
          "else": {
            "properties": {
              "actual_time_reason": {
                "const": null
              }
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "epub-image"
        },
        "resource": {
          "type": "string",
          "minLength": 1
        },
        "parent_resource": {
          "type": "string",
          "minLength": 1
        },
        "reading_order": {
          "type": "integer",
          "minimum": 0
        },
        "occurrence": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "kind",
        "resource",
        "parent_resource",
        "reading_order",
        "occurrence"
      ],
      "additionalProperties": false
    }
  ]
}
