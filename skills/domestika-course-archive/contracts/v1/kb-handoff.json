{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:organized-mind:kb-handoff:1",
  "title": "kb-handoff",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "kb-handoff/v1"
    },
    "source": {
      "$ref": "urn:organized-mind:source-identity:1"
    },
    "manifest": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "additionalProperties": false
    },
    "text_chunks": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "additionalProperties": false
    },
    "image_records": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "additionalProperties": false
    },
    "blobs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false
      }
    },
    "ordered_membership": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "expected_text_chunks": {
      "type": "integer",
      "minimum": 0
    },
    "expected_image_records": {
      "type": "integer",
      "minimum": 0
    },
    "state": {
      "enum": [
        "pending",
        "completed"
      ]
    },
    "consumer_receipt": {
      "oneOf": [
        {
          "const": null
        },
        {
          "type": "object",
          "properties": {
            "source_id": {
              "type": "string",
              "minLength": 1
            },
            "source_revision": {
              "type": "string",
              "minLength": 1
            },
            "expected_text_chunks": {
              "type": "integer",
              "minimum": 0
            },
            "actual_text_chunks": {
              "type": "integer",
              "minimum": 0
            },
            "expected_image_records": {
              "type": "integer",
              "minimum": 0
            },
            "actual_image_records": {
              "type": "integer",
              "minimum": 0
            },
            "saved": {
              "const": true
            },
            "indexed": {
              "const": true
            }
          },
          "required": [
            "source_id",
            "source_revision",
            "expected_text_chunks",
            "actual_text_chunks",
            "expected_image_records",
            "actual_image_records",
            "saved",
            "indexed"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "source",
    "manifest",
    "text_chunks",
    "image_records",
    "blobs",
    "ordered_membership",
    "expected_text_chunks",
    "expected_image_records",
    "state",
    "consumer_receipt"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "pending"
          }
        }
      },
      "then": {
        "properties": {
          "consumer_receipt": {
            "const": null
          }
        }
      },
      "else": {
        "properties": {
          "consumer_receipt": {
            "type": "object"
          }
        }
      }
    }
  ]
}
